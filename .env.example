# Скопируйте этот файл в .env и заполните значения.
# Файл .env НЕЛЬЗЯ публиковать и отправлять кому-либо.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Путь к файлу базы данных SQLite (относительно папки проекта)
DB_PATH=data/schoolvoice.db

# Часовой пояс школы для отображения дат
TIMEZONE=Asia/Tashkent

# Максимум обращений от одного ученика за 24 часа (0 — без ограничений)
MAX_APPEALS_PER_DAY=10

# Показывать ли администраторам имя и @username автора обращения (true/false)
SHOW_AUTHOR_TO_ADMINS=false

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
